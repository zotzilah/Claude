{
  "expo": {
    "name": "Project Biro",
    "slug": "project-biro",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "biro",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.projectbiro.app",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFD200",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.projectbiro.app"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#D8141C",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Biro uses Face ID so grown-ups can leave Kid Mode."
        }
      ],
      "expo-secure-store",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Biro uses the microphone so children can say what they're looking for, like \"dinosaurs!\". Nothing is recorded.",
          "speechRecognitionPermission": "Biro turns what your child says into a search. Only the words are used, never the recording."
        }
      ],
      [
        "expo-share-intent",
        {
          "iosActivationRules": {
            "NSExtensionActivationSupportsWebURLWithMaxCount": 1,
            "NSExtensionActivationSupportsWebPageWithMaxCount": 1,
            "NSExtensionActivationSupportsText": true
          },
          "iosShareExtensionName": "Biro",
          "androidIntentFilters": [
            "text/*"
          ]
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#D8141C"
        }
      ],
      "expo-dev-client"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
